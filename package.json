{
  "name": "diratrack",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,green \"npm run dev -w @diratrack/web\" \"npm run dev -w @diratrack/research-worker\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:live": "LIVE_API_TESTS=1 playwright test --grep @live",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @diratrack/database",
    "db:migrate": "npm run db:migrate -w @diratrack/database",
    "db:seed": "npm run db:seed -w @diratrack/database"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
